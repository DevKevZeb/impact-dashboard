# Environment Variables for Development
# Copy this file to .env.local and update values as needed

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# App Configuration
VITE_APP_NAME=PacificEcommerce

# Demo mode: when "true", the app runs against a built-in mocked API
# (src/mocks/) instead of VITE_API_BASE_URL - no backend required. Used for
# the public portfolio deployment. Leave unset/false for real backend work.
VITE_DEMO_MODE=false

# reCAPTCHA v2 Configuration
# Google reCAPTCHA v2 Checkbox Site Key (public)
VITE_RECAPTCHA_SITE_KEY=6LekrposAAAAAKwvGRkvqbH3vA3IOsi-lwK9A5Zd
